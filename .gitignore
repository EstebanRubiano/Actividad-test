node_modules/
dist/
dist-ssr/
*.local

# ==========================================
# 2. Logs y Diagnósticos
# ==========================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ==========================================
